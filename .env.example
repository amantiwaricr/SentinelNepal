# SentinelNepal configuration template. Copy to ".env" (git-ignored) and change the values.
# This file must only ever contain placeholders.

# development | test | production  (production disables the interactive API docs)
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=sentinel
# Use a long random value, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinelnepal
# Port published on 127.0.0.1 by Docker Compose (5433 avoids clashing with a local PostgreSQL).
POSTGRES_HOST_PORT=5433

# Used when the backend runs natively (outside Docker) against the Compose database.
# Inside Compose these are overridden to db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Alternatively set a full URL (takes precedence over the POSTGRES_* parts):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/sentinelnepal

# --- Backend API ---
# Comma-separated list of browser origins allowed to call the API. '*' is rejected.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# json (default, for machines) or text (easier to read in a terminal)
LOG_FORMAT=json

# --- Optional settings (defaults shown) ---
# Sessions and login protection
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# SESSION_COOKIE_SECURE=          # empty = Secure only when ENVIRONMENT=production
# LOGIN_RATE_LIMIT_ATTEMPTS=10    # per client IP per window
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# LOCKOUT_THRESHOLD=5             # failed passwords before a temporary account lock
# LOCKOUT_MINUTES=15

# Dataset analysis
# MAX_UPLOAD_MB=200
# MODEL_ARTIFACTS_DIR=            # default: ml/artifacts (Docker: /models, mounted read-only)
# ANALYSIS_WORKER_ENABLED=true
# MAX_ALERTS_PER_RUN=100000

# Live monitoring (Phase 6)
# LIVE_MODEL_PROFILE=full_no_ttl  # the model profile used for live and replayed flows
# COLLECTOR_OFFLINE_SECONDS=30

# Firewall requests (nothing is applied before Phase 7)
# FIREWALL_PROTECTED_NETWORKS=192.168.56.0/24   # comma-separated; never blockable
# FIREWALL_MAX_DURATION_SECONDS=3600
# FIREWALL_ALLOW_SELF_APPROVAL=false            # true only for single-person demos
# FIREWALL_ANALYSTS_MAY_REQUEST=false

# --- Monitoring lab (docker compose --profile lab) ---
# Token of the lab collector, printed once by:
#   docker compose exec backend python -m app.cli create-collector --name lab-sensor
COLLECTOR_TOKEN=
